{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yieldwerx.example/schemas/probe-config.schema.json",
  "title": "PROBE consumer configuration",
  "type": "object",
  "required": ["schemaVersion", "probeVersion", "paths"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "probeVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "profile": {
      "type": "string",
      "default": "generic"
    },
    "paths": {
      "type": "object",
      "required": ["features", "ledgers", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "requirements": { "type": "string" },
        "features": { "type": "string" },
        "ledgers": { "type": "string" },
        "artifacts": { "type": "string" },
        "testData": { "type": "string" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "integrations": {
      "type": "object",
      "properties": {
        "knowledge": {
          "type": "object",
          "required": ["provider"],
          "properties": {
            "provider": {
              "type": "string"
            },
            "required": {
              "type": "boolean",
              "default": false
            },
            "source": {
              "type": "string"
            },
            "marketplace": {
              "type": "string"
            },
            "plugin": {
              "type": "string"
            },
            "skill": {
              "type": "string"
            },
            "revision": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            }
          },
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "claude-plugin"
                  }
                },
                "required": ["source"]
              },
              "then": {
                "required": ["marketplace", "plugin", "skill", "revision"]
              }
            }
          ]
        }
      },
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": true
          }
        ]
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": true
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gates": {
          "type": "object",
          "description": "Declares whether PROBE's human-signed gates block delivery in this repository. Hibernation suspends blocking only; evidence is still assembled and no gate is ever reported as approved.",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": ["active", "hibernated"],
              "default": "active"
            },
            "scope": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["design", "merge", "ops"] }
            },
            "authorizedBy": {
              "type": "object",
              "required": ["name", "email", "role"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "email": { "type": "string", "minLength": 3 },
                "role": { "type": "string", "minLength": 1 }
              }
            },
            "reason": { "type": "string", "minLength": 1 },
            "since": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "until": {
              "description": "Date hibernation ends automatically. null means it ends only by an explicit configuration change.",
              "oneOf": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "null" }]
            },
            "reviewOn": {
              "description": "Advisory review date. Surfaced in every gate report; never resumes gates on its own.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "mode": { "const": "hibernated" } },
                "required": ["mode"]
              },
              "then": {
                "required": ["scope", "authorizedBy", "reason", "since"]
              }
            }
          ]
        }
      }
    }
  }
}
