{
  "name": "@yieldwerx/probe-cli",
  "version": "2.13.2",
  "private": false,
  "description": "Source, validation and distribution repository for the YieldWerx PROBE process.",
  "author": {
    "name": "Tafseer Haider",
    "email": "tafseer.haider@yieldwerx.com"
  },
  "type": "module",
  "bin": {
    "probe": "bin/probe.mjs"
  },
  "files": [
    "bin/",
    "plugins/yieldwerx-probe/lib/",
    "plugins/yieldwerx-probe/scripts/",
    "plugins/yieldwerx-probe/adapters/aio/",
    "plugins/yieldwerx-probe/skills/probe-spec/scripts/",
    "config/probe-config.schema.json",
    "README.md",
    "LICENSE.md",
    "plugins/yieldwerx-probe/hooks/"
  ],
  "scripts": {
    "validate": "node scripts/validate-repository.mjs",
    "validate:spec": "node plugins/yieldwerx-probe/skills/probe-spec/scripts/validate-spec-analysis.mjs",
    "validate:reconciliation": "node plugins/yieldwerx-probe/skills/probe-spec/scripts/validate-spec-reconciliation.mjs",
    "test:spec-validator": "node scripts/test-spec-validator.mjs && node scripts/test-spec-reconciliation-validator.mjs",
    "test:cli": "node scripts/test-cli.mjs",
    "test:owner-bypass": "node scripts/test-owner-bypass.mjs",
    "test": "npm run validate && npm run test:spec-validator && npm run test:cli && npm run test:owner-bypass && npm run test:guards && npm run test:aio-payload",
    "test:guards": "node scripts/test-guards.mjs",
    "test:aio-payload": "node --experimental-strip-types scripts/test-aio-payload.mjs",
    "format": "npx --yes prettier@3 --write \"scripts/**/*.mjs\" \"bin/*.mjs\" \"plugins/**/*.mjs\"",
    "format:check": "npx --yes prettier@3 --check \"scripts/**/*.mjs\" \"bin/*.mjs\" \"plugins/**/*.mjs\""
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
